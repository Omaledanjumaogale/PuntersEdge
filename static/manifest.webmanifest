{
	"id": "/?source=pwa",
	"name": "PuntersEdge — Football & Basketball Value Bets",
	"short_name": "PuntersEdge",
	"description": "Fair prices, value bets and stake sizes for football and basketball, checked against SportyBet, 1xBet and 22Bet.",
	"lang": "en-NG",
	"dir": "ltr",
	"start_url": "/?source=pwa",
	"scope": "/",
	"display": "standalone",
	"display_override": [
		"window-controls-overlay",
		"standalone",
		"minimal-ui"
	],
	"orientation": "any",
	"background_color": "#0b0f26",
	"theme_color": "#7c4dff",
	"categories": [
		"sports",
		"finance",
		"utilities"
	],
	"prefer_related_applications": false,
	"launch_handler": {
		"client_mode": [
			"navigate-existing",
			"auto"
		]
	},
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
