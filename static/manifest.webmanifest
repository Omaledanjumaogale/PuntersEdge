{
	"id": "/?source=pwa",
	"name": "PuntersEdge Sports Projections",
	"short_name": "PuntersEdge",
	"description": "Live fixtures, fair prices, value bets and stake sizes for football, NBA, basketball, ice hockey and baseball, checked against SportyBet, 1xBet, 22Bet and more.",
	"lang": "en-NG",
	"dir": "ltr",
	"start_url": "/board?source=pwa",
	"scope": "/",
	"display": "standalone",
	"display_override": [
		"standalone",
		"minimal-ui"
	],
	"orientation": "portrait-primary",
	"background_color": "#0b0f26",
	"theme_color": "#7c4dff",
	"categories": [
		"sports",
		"finance",
		"utilities"
	],
	"prefer_related_applications": false,
	"launch_handler": {
		"client_mode": [
			"navigate-existing",
			"auto"
		]
	},
	"icons": [
		{
			"src": "/icons/brand-v2-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/brand-v2-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/brand-v2-maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icons/brand-v2-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		}
	],
	"shortcuts": [
		{
			"name": "Board",
			"short_name": "Board",
			"description": "Today's top picks",
			"url": "/board?source=shortcut",
			"icons": [
				{
					"src": "/icons/brand-v2-192.png",
					"sizes": "192x192"
				}
			]
		},
		{
			"name": "Value bets",
			"short_name": "Value",
			"description": "Every price above fair value, best first",
			"url": "/value-bets?source=shortcut",
			"icons": [
				{
					"src": "/icons/brand-v2-192.png",
					"sizes": "192x192"
				}
			]
		},
		{
			"name": "Sports",
			"short_name": "Sports",
			"description": "Football, NBA, basketball, hockey and baseball",
			"url": "/sports?source=shortcut",
			"icons": [
				{
					"src": "/icons/brand-v2-192.png",
					"sizes": "192x192"
				}
			]
		},
		{
			"name": "Results",
			"short_name": "Results",
			"description": "Scores and our track record",
			"url": "/results?source=shortcut",
			"icons": [
				{
					"src": "/icons/brand-v2-192.png",
					"sizes": "192x192"
				}
			]
		}
	],
	"screenshots": [
		{
			"src": "/screenshots/board-mobile.png",
			"sizes": "780x1688",
