{
	"id": "/?source=pwa",
	"name": "QuantEdge — Football & Basketball Value Bets",
	"short_name": "QuantEdge",
	"description": "Fair prices, value bets and stake sizes for football and basketball, checked against SportyBet, 1xBet and 22Bet.",
	"lang": "en-NG",
	"dir": "ltr",
	"start_url": "/?source=pwa",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
	"orientation": "any",
	"background_color": "#0b0f26",
	"theme_color": "#7c4dff",
	"categories": ["sports", "finance", "utilities"],
	"prefer_related_applications": false,
	"launch_handler": { "client_mode": ["navigate-existing", "auto"] },
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{
			"name": "Value bets",
			"short_name": "Value",
			"description": "Every price above fair value, best first",
			"url": "/value-bets?source=shortcut",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Football",
			"url": "/football?source=shortcut",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Basketball",
			"url": "/basketball?source=shortcut",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		}
	],
	"screenshots": [
		{
			"src": "/screenshots/board-mobile.png",
			"sizes": "780x1688",
			"type": "image/png",
			"form_factor": "narrow",
			"label": "Board with the 3D score distribution and strongest edges"
		},
		{
			"src": "/screenshots/match-mobile.png",
			"sizes": "780x1688",
			"type": "image/png",
			"form_factor": "narrow",
			"label": "Match detail with fair prices for every market"
		},
		{
			"src": "/screenshots/board-desktop.png",
			"sizes": "2560x1440",
			"type": "image/png",
			"form_factor": "wide",
			"label": "QuantEdge board on desktop"
		}
	]
}
