{
  "name": "puntersedge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Quantitative Sports Analytics, Predictions & PWA for Basketball Fixtures and Football Matches",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/finalize-static.mjs",
    "preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen": "wrangler types",
    "test": "node --test test/*.test.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "pipeline": "node scripts/pipeline.js",
    "build:single": "vite build && node scripts/build-single-file.mjs",
    "test:backend": "svelte-kit sync && vitest run --config vitest.config.ts",
    "check:backend": "tsc --noEmit -p convex/tsconfig.json"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.86",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-auth": "^1.6.22",
    "clsx": "^2.1.1",
    "convex": "^1.19.0",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.0.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.61",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.97.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=20"
  }
}
